# RAAD Platform — Docker Compose environment template (ADR-0013: docs/architecture/adr/
# 0013-platform-dockerization.md). Copy to `docker/.env` (gitignored, never commit real values —
# root .gitignore's `.env`/`.env.*`/`!.env.example` rule already covers this file's real copy)
# and run Compose from this `docker/` directory (or pass `--project-directory docker` /
# `-f docker/docker-compose.yml` from elsewhere) so it's picked up automatically.
#
# This is the ONE place Docker-Compose-level values live. It is intentionally separate from
# backend/.env.example, frontend/.env.example, and services/device-gateway/.env.example — those
# document each deployable's own env vars for running it directly, without Docker; keeping two
# copies of the same values in sync (one here, one there) would drift, so docker-compose.yml
# reads only from this file and injects the real container env vars (RAAD_DB__URL,
# RAAD_REDIS__URL, VITE_API_BASE_URL, ...) itself.
#
# Same file shape for local dev (Windows) and the production VPS — only the values differ.

# Compose reads this automatically (no -p/--profile flag needed) whenever it's set in the .env
# file next to the compose files being run. "gateway" activates the nginx (+ certbot in prod)
# service(s) — the default, so every command in docker/README.md's "Running it" section behaves
# exactly as before. Leave this UNSET (or remove the line) for the Coolify deployment path
# (docs/runbooks/coolify-deployment.md, docker-compose.coolify.yml) — Coolify's own Traefik owns
# reverse-proxy/TLS there, so this stack's own nginx/certbot must not also run.
COMPOSE_PROFILES=gateway

# --- PostgreSQL (ADR-0002) ---
# Dev-only defaults below match backend-pipeline.yml's own CI service container credentials.
# Set real values on the VPS.
POSTGRES_USER=raad
POSTGRES_PASSWORD=raad
POSTGRES_DB=raad
# Host-side published port ONLY. The container-internal port stays 5432, and every service
# reaches the database as `postgres:5432` on the Compose network — unchanged by this value.
# 5433 rather than 5432 because a native PostgreSQL install on a developer machine also binds
# 5432: Windows lets both bind without either erroring, the native server wins every loopback
# connection, and Docker's published port is silently shadowed. Local tooling then talks to a
# different database than the running stack, with no visible symptom. Local Windows/Alembic/
# test access therefore uses 127.0.0.1:5433.
POSTGRES_PORT=5433

# --- Redis (ADR-0008/ADR-0010/ADR-0012; hardened Priority 1 Item 4, docs/runbooks/
# --- redis-operations.md) ---
REDIS_PORT=6379
# Dev-only placeholder, same convention as RAAD_AUTH__JWT_SECRET_KEY below — set a real value on
# the VPS. Required by the `redis` service's own --requirepass and embedded into
# RAAD_REDIS__URL/RAAD_BROKER__URL/DEVICE_GATEWAY_BROKER_URL automatically (docker-compose.yml).
# Generate one the same way as the JWT secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=dev-only-change-me
# Redis's own --maxmemory ceiling. Once hit, writes fail loudly (--maxmemory-policy noeviction,
# docker-compose.yml's own comment on the `redis` service) rather than silently evicting data —
# raise this if a real deployment's event/notification volume grows into the ceiling.
REDIS_MAXMEMORY=256mb

# --- Shared broker stream trimming (audit finding B2) — LEAVE AT 0 -------------------------
# `raad:events` has THREE writers (Business API, device gateway, JT1078 relay), each with its
# own cap below. **All three must stay 0 (trimming disabled) under the current design**, and
# this block exists to explain why rather than to leave the reason buried in a Python docstring.
#
# The tempting fix is wrong, and was already tried. Redis runs `--maxmemory-policy noeviction`,
# so an unbounded stream will eventually fill REDIS_MAXMEMORY and fail every write — a real
# risk. But capping the stream is not the remedy: on 2026-09-02 these were briefly set to
# 100000 and trimming immediately evicted the OLDEST entries, which are the
# `DeviceRegistered`/`DeviceActivated`/`DeviceAssignedToVehicle` events that
# `services/device-gateway`'s `DeviceRegistryProjection` rebuilds itself from on every cold
# start (a full `XRANGE` over the whole stream, `RedisDeviceRegistryConsumer.replay_from_start`).
# The projection came back empty and the physical MDVR could no longer authenticate at all —
# `authentication_failed` on every `0x0102`. Device registration events are by definition the
# oldest entries, and GPS position reports are high-volume, so **no finite cap is safe here**:
# any value large enough to be useful still evicts the founding events eventually.
#
# `raad:events` is therefore not a transient bus — for the device registry it is the durable log
# of record. Bounding Redis memory requires making that projection stop depending on infinite
# history (persist it, or compact registry events onto their own keys). That is a design change,
# tracked as such; until it lands, monitor Redis memory rather than capping the stream.
RAAD_BROKER__STREAM_MAX_LENGTH=0
DEVICE_GATEWAY_STREAM_MAX_LENGTH=0
JT1078_RELAY_STREAM_MAX_LENGTH=0

# --- Business API ---
BACKEND_PORT=8000
RAAD_ENVIRONMENT=dev
# Dev-only placeholder — Settings.validate_on_startup() refuses to start when
# RAAD_ENVIRONMENT=prod and this is unset, so a real VPS deployment cannot silently run without
# one. Generate a real value for prod, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
RAAD_AUTH__JWT_SECRET_KEY=dev-only-change-me
# JSON array of allowed CORS origins (.claude/rules/frontend.md) — must include whatever origin
# the browser actually loads the frontend from. Default matches NGINX_PORT's own default (80).
RAAD_CORS__ALLOWED_ORIGINS=["http://localhost"]
RAAD_OBSERVABILITY__LOG_LEVEL=INFO

# RAAD_BOOTSTRAP_FOUNDER_EMAIL / RAAD_BOOTSTRAP_FOUNDER_PASSWORD are deliberately NOT set here.
# `users` starts empty on a fresh database by design (no default account) — run the bootstrap CLI
# once, ad hoc, after first `up`; see docker/README.md's "First login" section and
# docs/runbooks/founder-bootstrap.md. Not added to this file (or to docker-compose.yml's own
# `environment:` block) on purpose: a one-time-use password has no reason to sit in a persistent
# container environment.

# --- Backups (Priority 1 Item 1, docs/runbooks/backup-and-restore.md) ---
# How often the `backup` service dumps the database, in hours.
BACKUP_INTERVAL_HOURS=24
# How long local dumps are kept in the raad_backups_data volume before being pruned.
BACKUP_RETENTION_DAYS=14
# How long a backup run waits for PostgreSQL to start accepting connections before giving up.
# Compose's `depends_on: service_healthy` only orders the initial `compose up`; when Docker's
# restart policy brings containers back after a daemon restart or host reboot, `backup` can start
# first and would otherwise fail instantly. Safe default — raise it on a slow-booting host.
BACKUP_WAIT_FOR_DB_SECONDS=120
# How soon to retry after a failed backup. Without this a single transient failure would leave
# the platform with no fresh backup for a whole BACKUP_INTERVAL_HOURS.
BACKUP_RETRY_MINUTES=15
# Optional. An rclone remote:path (e.g. "s3-remote:raad-backups") to push each fresh dump to
# off-site, on top of the local copy. Left empty on purpose — no default, and no off-site
# destination is provisioned yet; the backup service runs local-only (with a loud warning on
# every run) until you configure a real remote here. See the runbook's "Configuring off-site
# storage" section before relying on this in production.
BACKUP_RCLONE_REMOTE=

# --- Payment Provider (ADR-0022, docs/architecture/adr/0022-payment-provider-architecture.md) ---
# Env vars, composition-root only (core/di/bootstrap.py) — never SystemSetting (org_admin holds
# admin.settings.read/.update too, which would let any Org Admin read/tamper with a platform-wide
# secret). Both left empty by default: PaymentProviderPort stays unbound, and
# POST /billing/payments persists the Payment as PENDING then fails loudly with
# NotImplementedError at the charge step — the same disclosed "mechanism complete, not
# live-tested against a real account" posture this file already carries for TLS/Redis. Set a real
# value only after VPS deployment, per this project's own realigned business model.
# "stripe" (real, verified adapter) | "evcplus" | "zaad" (interface-complete stubs that raise
# NotImplementedError — no real merchant API docs exist for either yet).
RAAD_PAYMENT__PROVIDER=
# JSON object. For "stripe": {"secret_key":"sk_test_...","webhook_secret":"whsec_..."} — from
# https://dashboard.stripe.com/test/apikeys and https://dashboard.stripe.com/test/webhooks.
RAAD_PAYMENT__PROVIDER_CREDENTIALS={}

# --- Device Gateway (ADR-0009/ADR-0010) ---
DEVICE_GATEWAY_JT808_PORT=7808
DEVICE_GATEWAY_MDVR_PORT=7809

# --- JT1078 Media Relay (ADR-0024, revised by ADR-0025 §5) ---
JT1078_RELAY_INGEST_PORT=7910
JT1078_RELAY_VIEWER_PORT=7911
# HMAC signing secret for viewer tokens (ADR-0024 §5 point 2/§15, ADR-0026 §6: minted by the
# relay itself, never the backend). Change for any non-dev deployment; there is no safe default.
# **Production must also set JT1078_RELAY_ENVIRONMENT=prod below** — RelayConfig.
# validate_on_startup() (P0 security fix, 2026-09-10) only enforces this secret's strength when
# that's set to "prod"; leaving it at "dev" while shipping a real deployment leaves the relay
# willing to mint/accept viewer tokens signed with this literal placeholder value.
JT1078_RELAY_VIEWER_TOKEN_SECRET=dev-only-change-me
# This deployable's own environment marker — independent of RAAD_ENVIRONMENT (no shared Settings
# class between the backend and this deployable, `.claude/rules/architecture.md` #2). Generate a
# real secret the same way as the others: python -c "import secrets; print(secrets.token_urlsafe(32))"
JT1078_RELAY_ENVIRONMENT=dev
# The relay's own public-facing viewer base URL (ADR-0030) — read by the backend/worker as
# RAAD_DEVICE_PLANE__JT1078_SIGNALING_URL; gates whether `VideoProviderPort` binds at all
# (`core/di/bootstrap.py`). Dev-only default: reachable from a browser on the same machine as
# this Compose stack. **Production must set a real value** — the relay's actual public URL
# (e.g. routed through nginx/Coolify's own TLS termination as `wss://<domain>/jt1078/viewer`),
# never left as `localhost`, which is unreachable from any real browser off this host.
JT1078_SIGNALING_URL=ws://localhost:7911
# ^ PRODUCTION (audit finding B1, now routable): set this to
#       JT1078_SIGNALING_URL=wss://<your-domain>/jt1078
#   `infrastructure/nginx/conf.d/prod.conf` and `prod-tls.conf` now both carry a `location
#   /jt1078/` block that proxies this WebSocket to `jt1078-relay:7911` over the gateway's own
#   TLS. Before that block existed there was NO route to the viewer socket at all, so the only
#   reachable form was a raw `ws://host:7911` — which a browser on an HTTPS page refuses as
#   mixed content, making live video and intercom structurally impossible in production.
#   Port 443 is also a port Cloudflare will proxy; 7911 is not.
#   Locally you may use either `ws://localhost:7911` (direct) or `ws://localhost/jt1078`
#   (through the gateway) — dev serves the dashboard over plain HTTP, so neither is blocked.
# The address a device dials to reach `JT1078_RELAY_INGEST_PORT` — a real, production-blocking
# gap found live (2026-08-19): left unset, `services/jt1078`'s own `RelayConfig.
# effective_public_ingest_host` falls back to its bind address `0.0.0.0`, which the relay then
# embeds verbatim in the `0x9101`/`0x9201` signaling body as `server_ip` — the device
# acknowledges the command (it's valid JT/T 808) but can never actually dial `0.0.0.0`, so no
# media ever arrives and every session times out `failed`, silently. No safe default exists
# here (unlike JT1078_SIGNALING_URL's own `ws://localhost:7911` — a browser and a device reach
# this host over different network paths, which this file cannot know in advance).
# **Must be set** to this host's real device-reachable IP/hostname: local dev/bench testing —
# this machine's LAN IP the device already successfully dials for
# DEVICE_GATEWAY_JT808_PORT/7808; production — the VPS's public IP/domain. The relay speaks raw
# extended-RTP on this port, not HTTP(S), so — unlike JT1078_SIGNALING_URL's viewer WebSocket —
# it cannot be routed through nginx/Coolify's own reverse proxy; it needs its own direct TCP
# port mapping/forward.
JT1078_RELAY_PUBLIC_INGEST_HOST=

# --- Frontend (Vite build-time constants, ADR-0011) ---
# Through the Nginx gateway (docker/README.md), not the backend container directly — update
# these (and RAAD_CORS__ALLOWED_ORIGINS above) together if NGINX_PORT or the deployed domain
# changes. Rebuilding the frontend image is required for a change here to take effect in prod
# (Vite inlines these at build time); in dev the Vite dev server picks them up on container start.
VITE_API_BASE_URL=http://localhost/api/v1
VITE_WS_BASE_URL=ws://localhost
# Get one from https://account.mapbox.com/ (free tier: 50k map loads/month). No default on
# purpose — matches frontend/.env.example's own stance.
VITE_MAPBOX_ACCESS_TOKEN=
# Stripe's own *publishable* key (ADR-0022) — safe to expose client-side by design, unlike
# RAAD_PAYMENT__PROVIDER_CREDENTIALS above (the secret key, backend-only). From
# https://dashboard.stripe.com/test/apikeys. No default on purpose.
VITE_STRIPE_PUBLISHABLE_KEY=
FRONTEND_PORT=5173

# --- Nginx gateway (the platform's single public entrypoint) ---
NGINX_PORT=80

# --- TLS (Priority 1 Item 2, docs/runbooks/tls-setup.md) ---
# Which nginx config the `nginx` service loads in prod (docker-compose.prod.yml). Stays
# "prod.conf" (plain HTTP, today's behavior) until you've completed the two-phase bootstrap in
# the runbook above — do not set this to prod-tls.conf before then, nginx will refuse to start
# without a real certificate already in place at DOMAIN_NAME's path.
NGINX_PROD_CONF=prod.conf
# The real domain pointing at this VPS's public IP. Empty on purpose — no domain is provisioned
# by this repository. Required before running certbot or switching NGINX_PROD_CONF above.
DOMAIN_NAME=
# Email Let's Encrypt uses for expiry notices and account recovery — required by certbot's own
# `--email` flag in the runbook's bootstrap command. Empty on purpose, same reasoning as DOMAIN_NAME.
TLS_EMAIL=
# How often the `certbot` service checks for a due renewal, in hours. certbot renew is a no-op
# outside its own ~30-day-before-expiry window, so checking twice a day (Let's Encrypt's own
# suggested cadence) is safe to leave as the default.
CERTBOT_RENEW_INTERVAL_HOURS=12
