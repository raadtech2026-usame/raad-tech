# Vite only exposes env vars prefixed VITE_ to client-side code.
# Copy to .env.local for local development (never commit .env/.env.local — see root .gitignore).

# Business API base URL (backend/raad/interfaces/http/api_v1.py's /api/v1 prefix).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket base URL (backend/raad/interfaces/http/ws.py's /ws/tracking, /ws/notifications).
VITE_WS_BASE_URL=ws://localhost:8000

# Mapbox GL JS access token (ADR-0011: docs/architecture/adr/0011-mapbox-map-provider.md).
# Required by shared/map/providers/MapboxMapProvider — get one from https://account.mapbox.com/
# (free tier: 50k map loads/month). No default/fallback value — left empty here on purpose.
VITE_MAPBOX_ACCESS_TOKEN=

# Stripe publishable key (ADR-0022: docs/architecture/adr/0022-payment-provider-architecture.md).
# Safe to expose client-side by design — this is NOT the secret key (that lives only in the
# backend's RAAD_PAYMENT__PROVIDER_CREDENTIALS, never sent to this app). Get a test-mode key from
# https://dashboard.stripe.com/test/apikeys ("Publishable key", starts with pk_test_). Required
# by features/billing/OrgBillingPage's "Pay Invoice" flow — no default/fallback value.
VITE_STRIPE_PUBLISHABLE_KEY=
