# Backend environment configuration template — placeholder only.
# No real secrets. Populate per-environment values via a secrets manager, not this file.
#
# Variable names match core/config/settings.py exactly: RAAD_<GROUP>__<FIELD>
# (double underscore is the nested-settings delimiter — see Settings.model_config).

# --- Application ---
# RAAD_ENVIRONMENT=dev   # dev | staging | prod

# --- Database (PostgreSQL, ADR-0002) — wired in Phase 4.4 (core/db). Engine/UnitOfWork are
# --- left unbound in DI until URL is set; also read directly by `alembic` via migrations/env.py.
# --- URL must use the asyncpg dialect: postgresql+asyncpg://user:password@host:5432/raad
# RAAD_DB__URL=
# RAAD_DB__POOL_SIZE=5

# --- Redis (Backend Stabilization phase; hardened Priority 1 Item 4, docs/runbooks/
# --- redis-operations.md) — wires tracking.infra.adapters.RedisLatestPositionPort (Database
# --- Design §7.1, latest vehicle position, read-only — the device-gateway service is the
# --- documented writer of `vehicle:{id}:last`, not this backend), GeofenceStatePort, and the
# --- login rate limiter (Priority 1 Item 3). Left unbound in DI until URL is set, same "fail
# --- loudly, don't fake it" policy as RAAD_DB__URL. Local dev: docker/docker-compose.yml's
# --- `redis` service (ADR-0012) — if running the backend directly against that container
# --- (rather than through Docker Compose end-to-end), include the same REDIS_PASSWORD from
# --- docker/.env: redis://:dev-only-change-me@localhost:6379/0. Empty username before the
# --- colon is deliberate (Redis's own no-username-ACL default user).
# --- socket_connect_timeout_seconds / socket_timeout_seconds / health_check_interval_seconds
# --- are also configurable here (RAAD_REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS, etc.) — sensible
# --- defaults (3s / 3s / 30s) apply if unset.
# RAAD_REDIS__URL=redis://:dev-only-change-me@localhost:6379/0

# --- Event Broker (Redis Streams, ADR-0008) — RedisStreamsBrokerPort/BrokerConsumer,
# --- core.workers.scheduler.LockPort, core.workers.dlq.DeadLetterQueue. Independently
# --- configurable from RAAD_REDIS__URL above (ADR-0008's own precedent), but conventionally the
# --- same Redis *process*, a different logical db (1, vs. RAAD_REDIS__URL's db 0 — Priority 1
# --- Item 4, matching backend-pipeline.yml's own CI convention) — also the URL device-gateway's
# --- own DEVICE_GATEWAY_BROKER_URL must match exactly (password + db number) for the two
# --- deployables to share the `raad:events` stream (ADR-0010).
# RAAD_BROKER__URL=redis://:dev-only-change-me@localhost:6379/1

# --- Auth (JWT) — wired in Phase 4.3 (core/security). TokenService is left unbound in DI
# --- until JWT_SECRET_KEY is set (dev/staging), and is required in prod.
# RAAD_AUTH__JWT_SECRET_KEY=
# RAAD_AUTH__JWT_ALGORITHM=HS256
# RAAD_AUTH__ACCESS_TOKEN_TTL_SECONDS=900
# RAAD_AUTH__REFRESH_TOKEN_TTL_SECONDS=1209600
# RAAD_AUTH__PASSWORD_POLICY__MIN_LENGTH=10
# RAAD_AUTH__PASSWORD_POLICY__REQUIRE_UPPERCASE=true
# RAAD_AUTH__PASSWORD_POLICY__REQUIRE_LOWERCASE=true
# RAAD_AUTH__PASSWORD_POLICY__REQUIRE_DIGIT=true
# RAAD_AUTH__PASSWORD_POLICY__REQUIRE_SPECIAL=true

# --- FCM (Push Notifications) — not yet wired in this phase ---
# RAAD_FCM__CREDENTIALS_PATH=

# --- Payment Provider (EVC Plus) — not yet wired in this phase ---
# RAAD_PAYMENT__PROVIDER=evcplus

# --- Maps — not yet wired in this phase ---
# RAAD_MAPS__PROVIDER=

# --- Device Plane signaling (JT808/JT1078 seam, D6) — not yet wired in this phase ---
# RAAD_DEVICE_PLANE__JT808_SIGNALING_URL=
# RAAD_DEVICE_PLANE__JT1078_SIGNALING_URL=

# --- Observability ---
# RAAD_OBSERVABILITY__LOG_LEVEL=INFO
# RAAD_OBSERVABILITY__LOG_FORMAT=json
